# Course demo: copy to .env and fill the three required secrets.
HTTP_PORT=8080
MYSQL_PORT=3307
MYSQL_ROOT_PASSWORD=
MYSQL_PASSWORD=
# Generate a JWT secret with: openssl rand -hex 32
JWT_SECRET=

# Local demo returns verification codes in API responses.
VERIFICATION_DEBUG_CODE_ENABLED=true
VERIFICATION_EMAIL_ENABLED=false
VERIFICATION_EMAIL_CODE_SECRET=
SMTP_HOST=
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=

# Configure these to enable attachment uploads.
ALIYUN_OSS_ENDPOINT=https://oss-cn-beijing.aliyuncs.com
ALIYUN_OSS_BUCKET=campusbridge
ALIYUN_OSS_REGION=cn-beijing
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_SESSION_TOKEN=
