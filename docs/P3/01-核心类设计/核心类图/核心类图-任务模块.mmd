classDiagram
direction LR
class Task {
  id: Long
  requesterId: Long
  providerId: Long
  category: TaskCategory
  title: String
  description: String
  campus: String
  location: String
  deadline: LocalDateTime
  rewardType: RewardType
  status: TaskStatus
  assignProvider(Long): void
  markInProgress(): void
  markPendingConfirmation(): void
  markCompleted(): void
  markReviewed(): void
  markCancelled(): void
  markDisputed(): void
}
class TaskApplication {
  id: Long
  taskId: Long
  applicantId: Long
  message: String
  status: ApplicationStatus
  createdAt: LocalDateTime
  handledAt: LocalDateTime
}
class CompletionProof {
  id: Long
  taskId: Long
  submitterId: Long
  description: String
  submittedAt: LocalDateTime
}
class TaskHistory {
  id: Long
  taskId: Long
  fromStatus: TaskStatus
  toStatus: TaskStatus
  operatorId: Long
  note: String
  createdAt: LocalDateTime
}
class Review {
  id: Long
  taskId: Long
  reviewerId: Long
  revieweeId: Long
  rating: Integer
  comment: String
  createdAt: LocalDateTime
}
class TaskCategory {
  type: enumeration value list
  ERRAND value
  AGENCY value
}
class TaskStatus {
  type: enumeration value list
  DRAFT value
  OPEN value
  PENDING_REVIEW value
  ACCEPTED value
  IN_PROGRESS value
  PENDING_CONFIRMATION value
  COMPLETED value
  REVIEWED value
  CANCELLED value
  DISPUTED value
  REJECTED value
}
class RewardType {
  type: enumeration value list
  FREE value
  POINTS value
  CASH value
  NEGOTIABLE value
}
class ApplicationStatus {
  type: enumeration value list
  PENDING value
  ACCEPTED value
  REJECTED value
  WITHDRAWN value
}
Task o-- TaskApplication : 1-*
Task *-- CompletionProof : 0..1
Task *-- TaskHistory : 1-*
Task o-- Review : 0..2
Task --> TaskCategory : category
Task --> TaskStatus : status
Task --> RewardType : reward
TaskApplication --> ApplicationStatus : status
