%%{init: {"theme": "base", "themeVariables": {"fontFamily": "Arial, Microsoft YaHei, sans-serif", "fontSize": "14px", "primaryTextColor": "#1f2933", "lineColor": "#333333"}, "flowchart": {"curve": "linear"}, "class": {"hideEmptyMembersBox": true}}}%%
classDiagram
direction LR
class Conversation {
  id: Long
  type: ConversationType
  title: String
  ownerId: Long
  peerUserId: Long
  relatedType: String
  relatedId: Long
  replyable: Boolean
  lastMessageAt: LocalDateTime
}
class Message {
  id: Long
  conversationId: Long
  senderId: Long
  type: MessageType
  content: String
  readAt: LocalDateTime
  createdAt: LocalDateTime
}
class ConversationType {
  type: enumeration value list
  PRIVATE value
  SYSTEM value
  TASK value
}
class MessageType {
  type: enumeration value list
  TEXT value
  IMAGE value
  SYSTEM_NOTIFICATION value
}
Conversation *-- Message : 1-*
Conversation --> ConversationType : type
Message --> MessageType : type
class Conversation:::msg
class Message:::msg
class ConversationType:::msg
class MessageType:::msg
classDef view fill:#E9F5FF,stroke:#2F80ED,color:#1f2933;
classDef user fill:#F0F7EA,stroke:#5A9C42,color:#1f2933;
classDef post fill:#FFF6DE,stroke:#D99A00,color:#1f2933;
classDef task fill:#FDECEC,stroke:#D94B4B,color:#1f2933;
classDef msg fill:#F1ECFF,stroke:#7B61D1,color:#1f2933;
classDef attach fill:#EEF2F5,stroke:#607D8B,color:#1f2933;
classDef govern fill:#FFF0F6,stroke:#C94F8A,color:#1f2933;
classDef service fill:#F5F5F5,stroke:#555555,color:#1f2933;
