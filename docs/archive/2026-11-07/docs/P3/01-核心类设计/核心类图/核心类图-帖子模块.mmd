classDiagram
direction LR
class Post {
  id: Long
  authorId: Long
  category: PostCategory
  title: String
  content: String
  status: PostStatus
  replyCount: Integer
  likeCount: Integer
  markCount: Integer
}
class Reply {
  id: Long
  postId: Long
  authorId: Long
  parentReplyId: Long
  content: String
  status: PostStatus
  likeCount: Integer
}
class PostInteraction {
  id: Long
  userId: Long
  targetType: InteractionTargetType
  targetId: Long
  type: PostInteractionType
  createdAt: LocalDateTime
}
class PostCategory {
  type: enumeration value list
  INQUIRY_HELP value
  SECOND_HAND value
  TEAM_FRIEND value
  CAMPUS_SOCIAL value
}
class PostStatus {
  type: enumeration value list
  DRAFT value
  PUBLISHED value
  PENDING_REVIEW value
  HIDDEN value
  CLOSED value
  DELETED value
  REJECTED value
}
class InteractionTargetType {
  type: enumeration value list
  POST value
  REPLY value
}
class PostInteractionType {
  type: enumeration value list
  LIKE value
  MARK value
}
Post *-- Reply : 1-*
Reply --> Reply : parent
Post --> PostCategory : category
Post --> PostStatus : status
Reply --> PostStatus : status
PostInteraction --> Post : target
PostInteraction --> Reply : target
PostInteraction --> InteractionTargetType : targetType
PostInteraction --> PostInteractionType : type
class Post:::post
class Reply:::post
class PostInteraction:::post
class PostCategory:::post
class PostStatus:::post
class InteractionTargetType:::post
class PostInteractionType:::post
