<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.campusbridge.mapper.UserCreditMapper">

  <insert id="insert" parameterType="com.campusbridge.pojo.UserCredit" useGeneratedKeys="true" keyProperty="id">
    INSERT INTO user_credits (user_id, points, level, updated_at)
    VALUES (#{userId}, #{points}, #{level}, #{updatedAt})
  </insert>

  <select id="selectById" resultType="com.campusbridge.pojo.UserCredit">
    SELECT * FROM user_credits
    WHERE id = #{id}
  </select>

  <select id="selectAll" resultType="com.campusbridge.pojo.UserCredit">
    SELECT * FROM user_credits
  </select>

  <update id="updateById" parameterType="com.campusbridge.pojo.UserCredit">
    UPDATE user_credits
    SET user_id = #{userId},
      points = #{points},
      level = #{level},
      updated_at = #{updatedAt}
    WHERE id = #{id}
  </update>

  <delete id="deleteById">
    DELETE FROM user_credits
    WHERE id = #{id}
  </delete>

</mapper>
